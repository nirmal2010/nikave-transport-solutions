# ============================================================================
# NIKAVE Transport Solutions — Environment Variables Configuration
# ============================================================================

# Database Connection (Local PostgreSQL or Vercel Postgres / Neon)
# Local Docker/Podman: postgresql://postgres:postgres@localhost:5432/nikave_db
# Local Homebrew: postgresql://localhost:5432/nikave_db
# Vercel / Neon Cloud: postgresql://username:password@ep-xxxx.neon.tech/neondb?sslmode=require
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/nikave_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nikave_db

# Vercel Cron Authentication Secret
CRON_SECRET=nikave_cron_secret_key_12345

# Transport Manager Notification Config (100% Free Channels)
CALLMEBOT_PHONE=+919876543210
CALLMEBOT_API_KEY=your_free_callmebot_api_key

# Android Local SMS Gateway (Optional: For cellular SIM SMS dispatch)
ANDROID_GATEWAY_AUTH_KEY=nikave_device_gateway_key_99
ANDROID_GATEWAY_WEBHOOK_URL=http://localhost:3000/api/sms-queue
